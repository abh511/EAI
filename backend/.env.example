# Copy to backend/.env and fill in. Never commit the real .env.

# Secret for signing demo-login JWTs (any long random string)
SECRET_KEY=change-me

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase → Project Settings → Database (URL-encode special characters in the password, e.g. # → %23)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000

DATASET_PATH=./data/pune_mumbai_environmental_data_17022026.csv

# csv = read the bundled dataset; supabase = read env_readings (run scripts/migrate_and_seed.py first)
DATA_SOURCE=csv
